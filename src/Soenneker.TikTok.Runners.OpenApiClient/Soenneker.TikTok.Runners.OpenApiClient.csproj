<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A runner that regenerates and updates Soenneker.TikTok.OpenApiClient.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.TikTok.Runners.OpenApiClient</AssemblyName>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Utils.File" Version="11.0.2328" />
        <PackageReference Include="Soenneker.Utils.Directory" Version="11.0.970" />
        <PackageReference Include="Soenneker.Playwrights.Crawler" Version="11.0.343" />
        <PackageReference Include="Soenneker.AngleSharp.Parser" Version="11.0.120" />
        <PackageReference Include="Soenneker.Extensions.LoggerConfiguration" Version="11.0.1451" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Soenneker.Kiota.Util" Version="11.0.175" />
        <PackageReference Include="Soenneker.Managers.Runners" Version="11.0.2663" />
        <PackageReference Include="Soenneker.OpenApi.Fixer" Version="11.0.410" />
    </ItemGroup>
</Project>
