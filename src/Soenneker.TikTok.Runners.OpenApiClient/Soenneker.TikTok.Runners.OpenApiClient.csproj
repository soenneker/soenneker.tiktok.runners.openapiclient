<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A runner that regenerates and updates Soenneker.TikTok.OpenApiClient.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.TikTok.Runners.OpenApiClient</AssemblyName>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Utils.File" Version="4.0.2291" />
        <PackageReference Include="Soenneker.Utils.Directory" Version="4.0.949" />
        <PackageReference Include="Soenneker.Playwrights.Crawler" Version="4.0.296" />
        <PackageReference Include="Soenneker.AngleSharp.Parser" Version="4.0.93" />
        <PackageReference Include="Soenneker.Extensions.LoggerConfiguration" Version="4.0.1407" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="Soenneker.Kiota.Util" Version="4.0.142" />
        <PackageReference Include="Soenneker.Managers.Runners" Version="4.0.2590" />
        <PackageReference Include="Soenneker.OpenApi.Fixer" Version="4.0.375" />
    </ItemGroup>
</Project>
